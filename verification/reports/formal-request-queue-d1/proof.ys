read_verilog -formal -sv -DSYNTHESIS -Ibuild/formal-request-queue/1 build/formal-request-queue/1/observed.sv verification/formal_request_queue.sv
chparam -set DEPTH 1 formal_request_queue
prep -top formal_request_queue -flatten
